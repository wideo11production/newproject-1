VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@wideo11.com

# Email (Postal/Postfix)
# ============================================================================
# OUTBOUND EMAIL TRANSPORT
# ============================================================================
# Yehi 6 values dev aur production ke beech switch karti hain. Koi code change
# nahi - sirf `.env` me value badlo.
#
# HOW IT REACHES THE CODE:
#   .env (SMTP_*) -> compose maps to EMAIL_* -> viper (email.host etc.)
# Isliye yahan SIRF `SMTP_*` naam likho. `EMAIL_SERVER_*` ya raw `EMAIL_*`
# likhne se kuch nahi hoga - unhe koi map nahi karta.
#
# ---- DEVELOPMENT: Gmail ----
# Host par outbound port 25 block hai, isliye dev me Gmail (587) use karo.
# Gmail ke liye account password nahi, APP PASSWORD chahiye (exactly 16 chars,
# 4 groups of 4). Google Account -> Security -> 2-Step Verification -> App
# passwords. Free limit ~500 email/day.

EMAIL_SERVER_USER=jobhikarquiz@gmail.com
EMAIL_SERVER_PASSWORD=cklm kthu hbgb sqkx
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
# Sender address - wahi Gmail jo upar set kiya (ya uska alias)
EMAIL_FROM=jobhikarquiz@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jobhikarquiz@gmail.com
SMTP_PASSWORD=cklm kthu hbgb sqkx
SMTP_FROM=jobhikarquiz@gmail.com
SMTP_FROM_NAME=Wideo11 Security
SMTP_USE_TLS=true

# ---- PRODUCTION: own Postfix ----
# Upar wali 6 line ko in se replace karo:
#   SMTP_HOST=mail
#   SMTP_PORT=25
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_FROM=no-reply@wideo11.com
#   SMTP_USE_TLS=false
# Requirement: port 25 open ho + MX record set ho (wideo11.com. IN MX 10 mail.wideo11.com)
#
# SECURITY: is file me KABHI real credential mat likho - ye git me track hota hai.


# Monitoring
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# Feature Flags
ENABLE_SIGNUP=true
ENABLE_WITHDRAWAL=true
ENABLE_ADS=true
ENABLE_EDITOR=true
ENABLE_MONITORING=true

# Rate Limiting
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_UPLOAD_REQUESTS=5
RATE_LIMIT_UPLOAD_WINDOW=60

# Upload
MAX_FILE_SIZE=53687091200
CHUNK_SIZE=104857600

# Video
FFMPEG_PATH=/usr/bin/ffmpeg
HLS_SEGMENT_DURATION=6
DASH_SEGMENT_DURATION=6

# Transcoding
TRANSCODING_WORKERS=4
TRANSCODING_QUALITIES=144p,240p,360p,480p,720p,1080p,1440p,2160p,4320p


# Analytics
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Sentry (Optional)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

