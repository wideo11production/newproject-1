# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_EDITOR_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
NEXT_PUBLIC_ADS_URL=http://localhost:3004
NEXT_PUBLIC_MONITOR_URL=http://localhost:3005
NEXT_PUBLIC_CDN_URL=http://localhost:9000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wideo11?schema=public
DATABASE_URL_REPLICA=postgresql://postgres:postgres@localhost:5433/wideo11?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_URL=redis://localhost:7000,redis://localhost:7001,redis://localhost:7002

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_JETSTREAM_URL=nats://localhost:4222

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wideo11
MINIO_USE_SSL=false

# HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=90d
JWT_ISSUER=wideo11
JWT_AUDIENCE=wideo11

# VAPID Keys (Web Push)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@wideo11.com

# Email (Postal/Postfix)
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@wideo11.com

# OAuth (Optional - not used per requirements)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Monitoring
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# Feature Flags
ENABLE_SIGNUP=true
ENABLE_WITHDRAWAL=true
ENABLE_ADS=true
ENABLE_EDITOR=true
ENABLE_MONITORING=true

# Rate Limiting
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_UPLOAD_REQUESTS=5
RATE_LIMIT_UPLOAD_WINDOW=60

# Upload
MAX_FILE_SIZE=53687091200
CHUNK_SIZE=104857600

# Video
FFMPEG_PATH=/usr/bin/ffmpeg
HLS_SEGMENT_DURATION=6
DASH_SEGMENT_DURATION=6

# Transcoding
TRANSCODING_WORKERS=4
TRANSCODING_QUALITIES=144p,240p,360p,480p,720p,1080p,1440p,2160p,4320p


# Analytics
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Sentry (Optional)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=