# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_EDITOR_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
NEXT_PUBLIC_ADS_URL=http://localhost:3004
NEXT_PUBLIC_MONITOR_URL=http://localhost:3005
NEXT_PUBLIC_CDN_URL=http://localhost:9000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/wideo11
DATABASE_URL_REPLICA=postgresql://USER:PASSWORD@postgres-replica:5432/wideo11

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_URL=redis://redis:6379

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_JETSTREAM_URL=nats://localhost:4222

# MinIO
# NOTE: compose in vars ko padhta hai. Purane `MINIO_ACCESS_KEY` /
# `MINIO_SECRET_KEY` / `MINIO_BUCKET` names kahin use nahi hote the -
# infra silently apne defaults pe chalti thi. Neeche SAHI names hain.
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
# ROOT = admin-everything. Sirf provisioning (minio-init) ke liye.
# Services ko ye mat do - niche scoped account use karo.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
# Bucket names
MINIO_VIDEO_BUCKET=video
MINIO_THUMBNAIL_BUCKET=thumbnails
MINIO_AVATAR_BUCKET=avatars
# Browser-facing host (container-internal "minio:9000" NAHI)
MINIO_PUBLIC_HOST=localhost:9000
# ---- Scoped service account (auth-service ke liye) ----
# Generate karne ke liye: openssl rand -base64 32 | tr -d '/+='
# In dono ke bina compose `docker compose up` FAIL karega (`:?` se) -
# ye deliberate hai, taaki koi galti se root credentials na daal de.
MINIO_AUTH_ACCESS_KEY=change-me
MINIO_AUTH_SECRET_KEY=change-me

# HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=CHANGE_ME

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=90d
JWT_ISSUER=wideo11
JWT_AUDIENCE=wideo11

# VAPID Keys (Web Push)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@wideo11.com

# Email (Postal/Postfix)
# ============================================================================
# OUTBOUND EMAIL TRANSPORT
# ============================================================================
# Yehi 6 values dev aur production ke beech switch karti hain. Koi code change
# nahi - sirf `.env` me value badlo.
#
# HOW IT REACHES THE CODE:
#   .env (SMTP_*) -> compose maps to EMAIL_* -> viper (email.host etc.)
# Isliye yahan SIRF `SMTP_*` naam likho. `EMAIL_SERVER_*` ya raw `EMAIL_*`
# likhne se kuch nahi hoga - unhe koi map nahi karta.
#
# ---- DEVELOPMENT: Gmail ----
# Host par outbound port 25 block hai, isliye dev me Gmail (587) use karo.
# Gmail ke liye account password nahi, APP PASSWORD chahiye (exactly 16 chars,
# 4 groups of 4). Google Account -> Security -> 2-Step Verification -> App
# passwords. Free limit ~500 email/day.

EMAIL_SERVER_USER=mailer@example.com
EMAIL_SERVER_PASSWORD=CHANGE_ME
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
# Sender address - wahi Gmail jo upar set kiya (ya uska alias)
EMAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Wideo11 Security
SMTP_USE_TLS=true

# ---- PRODUCTION: own Postfix ----
# Upar wali 6 line ko in se replace karo:
#   SMTP_HOST=mail
#   SMTP_PORT=25
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_FROM=no-reply@wideo11.com
#   SMTP_USE_TLS=false
# Requirement: port 25 open ho + MX record set ho (wideo11.com. IN MX 10 mail.wideo11.com)
#
# SECURITY: is file me KABHI real credential mat likho - ye git me track hota hai.


# Monitoring
PROMETHEUS_URL=http://localhost:9090
ALERTMANAGER_URL=http://localhost:9093
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686

# Feature Flags
ENABLE_SIGNUP=true
ENABLE_WITHDRAWAL=true
ENABLE_ADS=true
ENABLE_EDITOR=true
ENABLE_MONITORING=true

# Rate Limiting
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=900
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_UPLOAD_REQUESTS=5
RATE_LIMIT_UPLOAD_WINDOW=60

# Upload
MAX_FILE_SIZE=53687091200
CHUNK_SIZE=104857600

# Video
FFMPEG_PATH=/usr/bin/ffmpeg
HLS_SEGMENT_DURATION=6
DASH_SEGMENT_DURATION=6

# Transcoding
TRANSCODING_WORKERS=4
TRANSCODING_QUALITIES=144p,240p,360p,480p,720p,1080p,1440p,2160p,4320p


# Analytics
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Sentry (Optional)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================================================
# EMAIL TRANSPORT (development) - PLACEHOLDERS ONLY
# ============================================================================
# SECURITY (read before you edit this file):
#   Ye `.env.example` GIT ME TRACKED hai. Jo bhi value aap yahan likhenge wo
#   PUBLIC repo me chala jayega. Isliye is file me KABHI real credential
#   mat likhiye - sirf placeholder daaliye.
#
#   Real values sirf `.env` me jaani chahiye (wo .gitignore me hai).
#
#   NOTE: ek baar commit hone ke baad secret ko hata dena KAHI KAFAI nahi hota -
#   git history me rehta hai. Isliye pehle check karo, phir commit karo.
#
# ---- Gmail (development only) ----
# Gmail raw password NAHI maangta - 2FA on hone par "App Password" chahiye
# (16 character, spaces ke saath). Account settings -> Security -> App
# passwords se generate hota hai.
# DEV NOTE: Gmail ka free sending limit ~500 email/day hai, aur zyada bhejne
# par account flag/suspend ho sakta hai - sirf testing ke liye use karo.
EMAIL_SERVER_USER=mailer@example.com
EMAIL_SERVER_PASSWORD=CHANGE_ME
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
# Sender address - wahi Gmail jo upar set kiya (ya uska alias)
EMAIL_FROM=no-reply@example.com
# Test recipient(s) - verification emails yahan bhejni hain
EMAIL_MAIL_RECIEVER=security@example.com


# Amazon Pay Configuration (Sandbox/Test)
AMAZON_PAY_PUBLIC_KEY_ID=SANDBOX-AWSACCESSKEYID
AMAZON_PAY_PRIVATE_KEY=SANDBOX-AWSSECRETACCESSKEY
AMAZON_PAY_STORE_ID=AMAZON_PAY_STORE_ID_HERE
AMAZON_PAY_PLATFORM_ID=PLATFORM-ID

RAZORPAY_KEY_ID=rzp_test_0000000000
RAZORPAY_KEY_SECRET=CHANGE_ME

UPI_ID=merchant@example

OPENAI_API_KEY=CHANGE_ME

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ---- Postgres monitoring (read-only, for Prometheus) ----
# Ye user `pg_monitor` role wala hai - exporter ke liye kaafi hai, superuser nahi.
# Banao: monitoring/grafana se pehle `postgres-exporter-init` automatically banata hai.
POSTGRES_EXPORTER_USER=wideo_monitor
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME

# ---- Grafana ----
# Local dev default. PRODUCTION me dono badlo - grafana ka default admin/admin hota hai.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

