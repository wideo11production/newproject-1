{
  "name": "eslint-config-wideo11",
  "version": "1.0.0",
  "description": "Shared ESLint configuration for Wideo11 microservices",
  "main": "index.js",
  "scripts": {
    "lint": "eslint 'packages/**/*.js' --ext .js,.jsx",
    "fix": "eslint 'packages/**/*.js' --ext .js,.jsx --fix"
  },
  "dependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^6.18.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^6.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0"
  },
  "override": {
    "extensions": [
      ".js",
      ".jsx",
      ".ts",
      ".tsx"
    ]
  }
}
