root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{go,proto}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{sh,bash,zsh}]
indent_size = 2